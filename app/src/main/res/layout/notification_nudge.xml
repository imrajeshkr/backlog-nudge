<?xml version="1.0" encoding="utf-8"?>
<!--
  Collapsed nudge. DecoratedCustomViewStyle draws the header (app name, time,
  chevron) and the action row itself; this is only the middle block.

  Colour comes from androidx's notification text appearances and is NOT set
  here. RemoteViews are inflated in SystemUI's context, so our own -night
  qualifier does not track the background the notification is actually drawn
  on - hardcoding a colour painted near-black ink onto a dark shade. Only
  fontFamily/size/caps are layered on top of the system appearance.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingStart="4dp"
    android:paddingEnd="4dp">

    <TextView
        android:id="@+id/nudge_title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:textAppearance="@style/TextAppearance.Compat.Notification.Title"
        android:fontFamily="@font/big_shoulders_display_bold"
        android:textAllCaps="true"
        android:textSize="18sp"
        android:letterSpacing="0.01"
        android:maxLines="1"
        android:ellipsize="end" />

    <TextView
        android:id="@+id/nudge_body"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:textAppearance="@style/TextAppearance.Compat.Notification"
        android:fontFamily="@font/hanken_grotesk_regular"
        android:textSize="13sp"
        android:maxLines="1"
        android:ellipsize="end" />
</LinearLayout>
