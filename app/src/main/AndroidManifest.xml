<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- Detection -->
    <uses-permission android:name="android.permission.PACKAGE_USAGE_STATS"
        tools:ignore="ProtectedPermissions" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <uses-permission android:name="android.permission.REQUEST_IGNORE_BATTERY_OPTIMIZATIONS" />

    <!-- Notifications / Bubbles -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- Lets the nudge pop straight to the front (over whatever app is open) when
         bubbles aren't available/enabled on this device, instead of waiting for a tap. -->
    <uses-permission android:name="android.permission.USE_FULL_SCREEN_INTENT" />

    <!-- Voice capture -->
    <uses-permission android:name="android.permission.RECORD_AUDIO" />

    <!-- Android 11+ hides other apps' install status unless declared here;
         without this, checking "is Instagram installed" always says no. -->
    <queries>
        <package android:name="com.instagram.android" />
    </queries>

    <application
        android:name=".BacklogNudgeApp"
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.BacklogNudge">

        <activity
            android:name=".ui.MainActivity"
            android:exported="true"
            android:theme="@style/Theme.BacklogNudge">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <activity
            android:name=".ui.OnboardingActivity"
            android:exported="false"
            android:theme="@style/Theme.BacklogNudge" />

        <activity
            android:name=".ui.SettingsActivity"
            android:exported="false"
            android:theme="@style/Theme.BacklogNudge" />

        <!-- Transparent trampoline launched from the Quick Settings Tile -->
        <activity
            android:name=".capture.VoiceCaptureActivity"
            android:exported="false"
            android:excludeFromRecents="true"
            android:launchMode="singleTask"
            android:theme="@style/Theme.BacklogNudge.Transparent" />

        <!-- Invisible trampoline for the notification's "Let's go" action - see LeaveAppActivity for why this can't just be a BroadcastReceiver. -->
        <activity
            android:name=".nudge.LeaveAppActivity"
            android:exported="false"
            android:excludeFromRecents="true"
            android:noHistory="true"
            android:theme="@style/Theme.BacklogNudge.Transparent" />

        <!-- Bubble-expanded activity showing the active nudge -->
        <activity
            android:name=".nudge.NudgeBubbleActivity"
            android:exported="false"
            android:allowEmbedded="true"
            android:documentLaunchMode="always"
            android:resizeableActivity="true"
            android:theme="@style/Theme.BacklogNudge" />

        <service
            android:name=".capture.CaptureTileService"
            android:exported="true"
            android:icon="@drawable/ic_tile_mic"
            android:label="@string/tile_label"
            android:permission="android.permission.BIND_QUICK_SETTINGS_TILE">
            <intent-filter>
                <action android:name="android.service.quicksettings.action.QS_TILE" />
            </intent-filter>
        </service>

        <service
            android:name=".detection.ForegroundWatcherService"
            android:exported="false"
            android:foregroundServiceType="specialUse">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="Detects continuous foreground time in watched apps to surface a backlog reminder" />
        </service>

        <receiver
            android:name=".nudge.NudgeActionReceiver"
            android:exported="false" />

        <receiver
            android:name=".detection.BootReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
            </intent-filter>
        </receiver>

    </application>
</manifest>
