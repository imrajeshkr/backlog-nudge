<?xml version="1.0" encoding="utf-8"?>
<!--
  Expanded nudge. Colour is NOT set here: RemoteViews are inflated in
  SystemUI's context, so our own -night qualifier does not track the
  background the notification is drawn on. Hardcoding painted near-black ink
  onto a dark shade. androidx's notification text appearances supply a colour
  that is correct for whichever background the system uses; we layer only
  fontFamily/size/caps on top. The green lives in setColor() on the header,
  where the platform manages its own contrast.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingStart="4dp"
    android:paddingEnd="4dp">

    <TextView
        android:id="@+id/nudge_chip"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="3dp"
        android:textAppearance="@style/TextAppearance.Compat.Notification.Info"
        android:fontFamily="@font/spline_sans_mono_regular"
        android:textAllCaps="true"
        android:textSize="10sp"
        android:letterSpacing="0.1"
        android:maxLines="1" />

    <TextView
        android:id="@+id/nudge_title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:textAppearance="@style/TextAppearance.Compat.Notification.Title"
        android:fontFamily="@font/big_shoulders_display_bold"
        android:textAllCaps="true"
        android:textSize="24sp"
        android:letterSpacing="0.01"
        android:maxLines="2"
        android:ellipsize="end" />

    <TextView
        android:id="@+id/nudge_body"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="5dp"
        android:textAppearance="@style/TextAppearance.Compat.Notification"
        android:fontFamily="@font/hanken_grotesk_regular"
        android:textSize="13.5sp"
        android:lineSpacingMultiplier="1.25"
        android:maxLines="4"
        android:ellipsize="end" />
</LinearLayout>
